   "source": [
    "#Consider the equation:\n",
    "# 3x = 5y + 10, 4x - 2y = 7\n",
    "\n",
    "import numpy as np\n",
    "A = np.array ([\n",
    "    [3,-5],\n",
    "    [4,-2]\n",
    "])\n",
    "\n",
    "B = np.array ([10,7])\n",
    "\n",
    "x,y = np.linalg.solve(A,B)\n",
    "\n",
    "print(\"x = \",x)\n",
    "print(\"y = \",y)"
   ]
  }
 ],
